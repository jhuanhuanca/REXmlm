APP_NAME="REXmlm"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://xeft.rexmlm.tech

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Rex_principal_bd
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=rexmlm

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Horizon: bloquear /horizon en Nginx o limitar a IP de admin. Solo rol admin.
HORIZON_PATH=horizon

# Auth Bearer (no cookies). No pongas los SPA aquí o Sanctum exigirá CSRF.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=20160
CORS_ALLOWED_ORIGINS=https://rexmlm.tech,https://www.rexmlm.tech,https://adxm.rexmlm.tech
FRONTEND_URL=https://rexmlm.tech
ADMIN_URL=https://adxm.rexmlm.tech

PRODUCT_SERVICE_URL=https://spxr.rexmlm.tech/api/v1
PRODUCT_SERVICE_TOKEN=
PRODUCT_SERVICE_TIMEOUT=8
PRODUCT_SERVICE_CACHE_TTL=300
PRODUCT_SERVICE_SYNC_TTL=900

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Vacío = producción abierta sin cobro SaaS. Al poner PADDLE_API_KEY también hace falta PADDLE_WEBHOOK_SECRET.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_SANDBOX=false
BILLING_OFFLINE=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@rexmlm.tech"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
